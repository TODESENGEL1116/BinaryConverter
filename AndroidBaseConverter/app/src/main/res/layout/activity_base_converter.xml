<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:padding="24dp">

    <!-- 顶部标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Base Converter"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 右上角分享图标 -->
    <ImageView
        android:id="@+id/iv_share"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_share"
        android:tint="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_title" />

    <!-- ========== 红色区域：位宽选择 + 正负分段控件 ========== -->
    <LinearLayout
        android:id="@+id/ll_top_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 左侧：位宽下拉框 -->
        <Spinner
            android:id="@+id/spinner_bit_width"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner_neumorph"
            android:paddingHorizontal="16dp"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:spinnerMode="dropdown"
            android:prompt="选择位宽"
            android:dropDownVerticalOffset="4dp" />

        <!-- 右侧：正负分段控件 -->
        <RadioGroup
            android:id="@+id/rg_sign"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_segment_container"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rb_positive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:text="正数"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="@color/selector_segment_text"
                android:background="@drawable/selector_segment_item" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rb_negative"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:text="负数"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="@color/selector_segment_text"
                android:background="@drawable/selector_segment_item" />

        </RadioGroup>

    </LinearLayout>

    <!-- 输入区域容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/ll_top_control"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BIN 二进制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_bin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIN"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:background="@drawable/bg_neumorph_normal" />

            <EditText
                android:id="@+id/et_bin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_neumorph_normal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:inputType="number"
                android:maxLines="1"
                android:hint="二进制"
                android:textColorHint="@color/text_hint"
                android:backgroundTint="@android:color/transparent" />
        </LinearLayout>

        <!-- DEC 十进制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_dec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEC"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:background="@drawable/bg_neumorph_normal" />

            <EditText
                android:id="@+id/et_dec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_neumorph_normal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:inputType="number"
                android:maxLines="1"
                android:hint="十进制"
                android:textColorHint="@color/text_hint"
                android:backgroundTint="@android:color/transparent" />
        </LinearLayout>

        <!-- OCT 八进制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_oct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OCT"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:background="@drawable/bg_neumorph_normal" />

            <EditText
                android:id="@+id/et_oct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_neumorph_normal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:inputType="number"
                android:maxLines="1"
                android:hint="八进制"
                android:textColorHint="@color/text_hint"
                android:backgroundTint="@android:color/transparent" />
        </LinearLayout>

        <!-- HEX 十六进制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEX"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:background="@drawable/bg_neumorph_normal" />

            <EditText
                android:id="@+id/et_hex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_neumorph_normal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:hint="十六进制"
                android:textColorHint="@color/text_hint"
                android:backgroundTint="@android:color/transparent" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
